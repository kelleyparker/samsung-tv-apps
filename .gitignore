# ROMs are copyrighted - supply your own (only the folder skeletons are tracked)
snes/roms/*
!snes/roms/.gitkeep
!snes/roms/README.md
snes-server/roms/*
!snes-server/roms/.gitkeep
!snes-server/roms/README.md
*.sfc
*.smc
*.nes
*.fds

# Personal media (photo icon and video) - add your own icon.png / video/clip.mp4
app1/icon.png
app1/photo_full.png
app1/video/
spike/icon.png

# Tizen build and signing output
*.wgt
.buildResult/
.sign/
author-signature.xml
signature*.xml

# Misc
snes-server/remote/
__pycache__/
*.log
